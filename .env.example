# Copie este arquivo para `.env` e preencha com valores locais.
# O arquivo `.env` NAO deve ser versionado (ja esta no .gitignore).
#
# Estes valores alimentam apenas o docker-compose, que os repassa aos containers
# como variaveis de ambiente. Nenhuma senha aparece em codigo, em YAML ou no Git.
#
# Use senhas alfanumericas: a do MongoDB entra numa URI de conexao, e caracteres
# como @ : / ? # precisariam de codificacao percentual para nao quebrar o parsing.

# --- PostgreSQL (profile-service) ---
PORTFOLIO_DB_NAME=profile_db
PORTFOLIO_DB_USER=portfolio
PORTFOLIO_DB_PASSWORD=troque-por-sua-senha-local

# --- MongoDB (project-service) ---
# Use uma senha DIFERENTE da do PostgreSQL: bancos distintos, credenciais
# distintas. Se uma vazar, a outra continua valendo.
PORTFOLIO_MONGO_DB=project_db
PORTFOLIO_MONGO_USER=portfolio
PORTFOLIO_MONGO_PASSWORD=troque-por-outra-senha-local
